CLOUDFLARE_TUNNEL_TOKEN=paste_cloudflare_tunnel_token_here

MYSQL_ROOT_PASSWORD=paste_root_password_here
MYSQL_DATABASE=pbl6_lungxray
MYSQL_USER=pbl6_admin
MYSQL_PASSWORD=paste_user_password_here

DATABASE_URL=mysql+pymysql://pbl6_admin:paste_user_password_here@db:3306/pbl6_lungxray

# JWT Secret
JWT_SECRET=paste_random_secret_string_here_min_16_chars

# base64 32-byte Fernet
ENCRYPTION_KEY=paste_valid_fernet_base64_key_here

# Cloudflare R2 Storage Configuration
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=pbl6-xray-images
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
R2_REGION=auto
R2_PRESIGNED_TTL_SECONDS=300
# Namespace for bucket: dev (local) prod (server)
R2_KEY_PREFIX=dev
